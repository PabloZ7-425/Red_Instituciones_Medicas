# Copia este archivo a .env  (cp .env.example .env)  y cambia las claves.
# El archivo .env NO se sube a GitHub.

# PostgreSQL - Hospital general
PG_USER=hospital_app
PG_PASSWORD=cambiar_pg_2026

# MySQL - Centro medico pediatrico
MYSQL_USER=pediatrico_app
MYSQL_PASSWORD=cambiar_mysql_2026
MYSQL_ROOT_PASSWORD=cambiar_root_2026

# B2: base tecnica de identidad, separada de hospital. Generar tres claves distintas.
# Para un volumen existente: inventario/respaldo/ensayo antes del cambio de modo.
IDENTITY_DB_MODE=postgres
IDENTITY_OWNER_PASSWORD=
IDENTITY_MIGRATOR_PASSWORD=
IDENTITY_APP_PASSWORD=
# Usar true al servir con HTTPS.
DJANGO_COOKIE_SECURE=false
